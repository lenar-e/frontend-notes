{
  // Один tsconfig на весь репозиторий: заметки (notes/), сайт и демо-приложение (website/).
  // Используется для `npm run typecheck` и IDE; сборкой занимаются Docusaurus и Vite.
  "extends": "@docusaurus/tsconfig",
  "compilerOptions": {
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "strict": true,
    "jsx": "react-jsx",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["node"],
    // @site — алиас Docusaurus на папку сайта
    "paths": {
      "@site/*": ["./website/*"]
    }
  },
  "exclude": ["**/.docusaurus", "**/build", "node_modules"]
}
