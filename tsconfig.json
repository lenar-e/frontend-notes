{
  // One tsconfig for the whole repo: notes (notes/), the site and the demo app (website/).
  // Used by `yarn typecheck` and the IDE; Docusaurus and Vite do the actual builds.
  "extends": "@docusaurus/tsconfig",
  "compilerOptions": {
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "strict": true,
    "jsx": "react-jsx",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["node"],
    // @site is the Docusaurus alias for the site folder
    "paths": {
      "@site/*": ["./website/*"]
    }
  },
  "exclude": ["**/.docusaurus*", "**/build", "node_modules"]
}
